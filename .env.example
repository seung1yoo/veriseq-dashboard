# Use python3 scripts/configure.py --demo for generated local credentials and demo reports.
COMPOSE_PROJECT_NAME=veriseq-lab
POSTGRES_PASSWORD=replace-with-a-random-hex-password
VERISEQ_INITIAL_ADMIN_EMAIL=admin@example.com
VERISEQ_INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
VERISEQ_HOST_SOURCE_PATH=./data
VERISEQ_HOST_SEED_PATH=./database/seed
VERISEQ_WEB_PORT=3000
VERISEQ_BIND_ADDRESS=127.0.0.1
# Blank allows any valid email address; users are still issued by an administrator.
VERISEQ_ALLOWED_EMAIL_DOMAIN=
VERISEQ_DEMO_MODE=false
VERISEQ_TIMEZONE=UTC
